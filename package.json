{
  "name": "cleanframe",
  "version": "1.2.0",
  "private": true,
  "description": "Personal Spanish launcher for Samsung S85F OLED TQ55S85FAUXXC.",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "npm run lint && python3 scripts/check.py && npm run check:device",
    "package": "python3 scripts/package.py",
    "tv:info": "python3 scripts/tv.py info",
    "tv:install": "python3 scripts/tv.py install",
    "tv:launch": "python3 scripts/tv.py launch",
    "check:browser": "node scripts/check-wallpaper-packs.mjs && node scripts/check-home-spacing.mjs && node scripts/check-header-materials.mjs && node scripts/check-live-programs.mjs",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "export:public": "python3 scripts/export-public.py",
    "check:public": "python3 scripts/check-public.py",
    "check:tools": "python3 -B scripts/test-tools.py",
    "lint": "eslint app",
    "check:device": "node --test scripts/test-device.mjs scripts/test-wallpaper-engine.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:browser:upstream": "node scripts/check-browser.mjs"
  },
  "devDependencies": {
    "eslint": "10.13.0",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
